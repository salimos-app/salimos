PORT=8082
FOURVENUES_API_HOST=cli-api-service.fourvenues.com
FOURVENUES_API_TOKEN=

# Gratis en https://openrouteservice.org/dev/#/signup (tier gratuito generoso)
ORS_API_KEY=

# Snapshot semanal de eventos (npm run sweep) y GET /api/discotecas/:slug/eventos-cache.
# Base gratis en https://turso.tech (sin tarjeta) — copia la "Database URL" y crea un token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secreto compartido con el workflow de GitHub Actions que dispara
# POST /api/internal/sweep una vez a la semana (ver .github/workflows/sweep-eventos.yml).
# Genera uno random, p.ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SWEEP_SECRET=
