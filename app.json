{
  "expo": {
    "name": "Salimos",
    "slug": "salimos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salimos.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para calcular la ruta hasta el sitio elegido."
      }
    },
    "android": {
      "package": "com.salimos.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D0B1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0B1E"
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "owner": "bartusito",
    "extra": {
      "eas": {
        "projectId": "cd1b476a-6353-456f-9b12-5ad0800c2bb3"
      }
    }
  }
}
